+++ b/pycep/transformer.py
@@ -889,6 +889,50 @@
     #
     ####################
 
+    def range_func(self, args: tuple[pycep_typing.PossibleValue, pycep_typing.PossibleValue]) -> dict[str, Any]:
+        start, count = args
+        return {"type": "range", "parameters": {"start": start, "count": count}}
+
+    def fail_func(self, args: tuple[pycep_typing.PossibleValue]) -> dict[str, Any]:
+        return {"type": "fail", "parameters": {"message": args[0]}}
+
+    def reduce_func(self, args: tuple) -> dict[str, Any]:
+        input_array, initial_value, accumulator, item, expression = args
+        return {
+            "type": "reduce",
+            "parameters": {
+                "input_array": input_array,
+                "initial_value": initial_value,
+                "accumulator": str(accumulator),
+                "input_element": str(item),
+                "expression": expression,
+            },
+        }
+
+    def to_object_func(self, args: tuple) -> dict[str, Any]:
+        input_array, key_item, key_expression, value_item, value_expression = args
+        return {
+            "type": "toObject",
+            "parameters": {
+                "input_array": input_array,
+                "key_element": str(key_item),
+                "key_expression": key_expression,
+                "value_element": str(value_item),
+                "value_expression": value_expression,
+            },
+        }
+
+    def map_func(self, args: tuple[pycep_typing.PossibleValue, Token, pycep_typing.PossibleValue]) -> dict[str, Any]:
+        input_array, input_element, expression = args
+        return {
+            "type": "map",
+            "parameters": {
+                "input_array": input_array,
+                "input_element": str(input_element),
+                "expression": expression,
+            },
+        }
+
     def filter(self, args: tuple[pycep_typing.PossibleValue, Token, pycep_typing.PossibleValue]) -> pycep_typing.Filter:
         input_array, input_element, expression = args
 
