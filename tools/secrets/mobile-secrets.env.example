# ─────────────────────────────────────────────────────────────────────────────
# Modèle de config pour set-keyvault-secrets.ps1.
# COPIER vers  mobile-secrets.env  (gitignoré : motif *.env) puis renseigner.
# Les *_FILE pointent vers des fichiers LOCAUX ; le script les encode si besoin.
# Une entrée vide ou absente => secret ignoré (chargement partiel possible :
# par ex. ne remplir que la partie Android pour démarrer).
# ─────────────────────────────────────────────────────────────────────────────

# --- Android ---
ANDROID_KEYSTORE_FILE=C:\chemin\vers\upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
PLAY_SERVICE_ACCOUNT_JSON_FILE=C:\chemin\vers\service-account.json

# --- iOS (laisser vide tant que la phase iOS n'est pas lancée) ---
IOS_DIST_CERT_P12_FILE=
IOS_DIST_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_FILE=
IOS_PROVISIONING_PROFILE_NAME=Microlingo Beta App Store
IOS_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8_FILE=


# --- iOS — fastlane match (recommandé : remplace cert/profil ci-dessus) ---
# IOS_MATCH_GIT_AUTH = base64 de "utilisateur:token" pour cloner le repo de certs en HTTPS.
IOS_MATCH_PASSWORD=
IOS_MATCH_GIT_AUTH=

# ─────────────────────────────────────────────────────────────────────────────
# Entra External ID (Microsoft CIAM) — dart-define values for Flutter
# ─────────────────────────────────────────────────────────────────────────────
# These values are passed to Flutter as --dart-define at build time.
# They configure the MSAL/AppAuth flow used in lib/src/app_env.dart.
# The build is safe to run with empty values; the app simply won't enable
# the Entra sign-in flow (entraConfigured == false) until all are filled.
#
# How to obtain each value:
#   Azure Portal → External Identities → your CIAM tenant → App registrations
#   → <your App Registration> → Overview
# ─────────────────────────────────────────────────────────────────────────────

# App Registration client ID (the "Application (client) ID" GUID shown on the
# App Registration Overview blade).
# Replace with: Azure Portal → External ID tenant → App registrations → <app> → Overview
ENTRA_CLIENT_ID=<your-entra-app-registration-client-id>

# CIAM authority URL. Format: https://<domain>.ciamlogin.com/<tenant-id>/v2.0
# Replace with: Azure Portal → External ID tenant → Overview → Authority / Issuer
ENTRA_AUTHORITY=https://<domain>.ciamlogin.com/<tenant-id>/v2.0

# Custom URI scheme registered as a redirect URI in the App Registration.
# Must match: App Registration → Authentication → Mobile and desktop applications
# Default for Microlingo is microlingo://auth — change only if you registered a different URI.
ENTRA_REDIRECT_URI=microlingo://auth

# OAuth2 scope for the backend API. Format: api://<backend-app-client-id>/user_impersonation
# Replace <backend-app-client-id> with the App Registration client ID of the *backend* API
# (Azure Portal → External ID tenant → App registrations → <backend-api-app> → Overview)
ENTRA_API_SCOPE=api://<backend-app-client-id>/user_impersonation

# Domain hints for social identity providers. These tell CIAM which IdP to use
# directly, skipping the CIAM account-picker screen.
# Values below are correct for standard Google and Apple social logins.
ENTRA_DOMAIN_HINT_GOOGLE=google.com
ENTRA_DOMAIN_HINT_APPLE=apple.com

# Microsoft Entra / work–school account domain hint (optional).
# Set to your tenant domain (e.g. contoso.com) if you want to support AAD sign-in,
# or leave empty to use the CIAM default flow for Microsoft accounts.
ENTRA_DOMAIN_HINT_MICROSOFT=

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (via Entra External ID)
# GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET sont configurés côté Azure CIAM,
# pas directement dans Flutter — rien à ajouter ici côté mobile.
# ─────────────────────────────────────────────────────────────────────────────
