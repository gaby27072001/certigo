# ─────────────────────────────────────────────────────────────────────────────
# Modèle de config pour set-keyvault-secrets.ps1.
# COPIER vers  mobile-secrets.env  (gitignoré : motif *.env) puis renseigner.
# Les *_FILE pointent vers des fichiers LOCAUX ; le script les encode si besoin.
# Une entrée vide ou absente => secret ignoré (chargement partiel possible :
# par ex. ne remplir que la partie Android pour démarrer).
# ─────────────────────────────────────────────────────────────────────────────

# --- Android ---
ANDROID_KEYSTORE_FILE=C:\chemin\vers\upload-keystore.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
PLAY_SERVICE_ACCOUNT_JSON_FILE=C:\chemin\vers\service-account.json

# --- iOS (laisser vide tant que la phase iOS n'est pas lancée) ---
IOS_DIST_CERT_P12_FILE=
IOS_DIST_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_FILE=
IOS_PROVISIONING_PROFILE_NAME=Certigo Beta App Store
IOS_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8_FILE=


# --- iOS — fastlane match ---
# ⛔ N'EST PLUS UTILISÉ. Constaté le 2026-09-11.
#    La signature iOS passe par Codemagic en signature automatique App Store
#    Connect : `codemagic.yaml` porte « no fastlane match » en tête de son bloc
#    de signature, et docs/RELEASE_MOBILE.md barre sa section « fastlane match »
#    (« Remplacé par Codemagic automatic signing »).
#    LAISSER CES DEUX VARIABLES VIDES. Les renseigner ne signe rien : aucune
#    étape de la chaîne de release ne les lit. Ce bloc n'est conservé que parce
#    que les secrets Key Vault correspondants existent encore.
#    Invalidé le jour où codemagic.yaml cesse d'utiliser la signature
#    automatique App Store Connect.
# IOS_MATCH_GIT_AUTH = base64 de "utilisateur:token" pour cloner le repo de certs en HTTPS.
IOS_MATCH_PASSWORD=
IOS_MATCH_GIT_AUTH=

# ─────────────────────────────────────────────────────────────────────────────
# Configuration app (dart-define) — NON secrète (finit dans le binaire public)
# ─────────────────────────────────────────────────────────────────────────────
# Injectée au build par les workflows CI (Android/iOS) via --dart-define.
# Source prioritaire = Key Vault (secrets mobile-app-*/mobile-entra-*) ; repli =
# variables GitHub `vars.MOBILE_*`. Renseignez-la ici pour peupler le Key Vault.
# Le build reste sûr avec des valeurs vides (l'app retombe sur ses défauts et
# social/login restent désactivés jusqu'à ce que tout soit renseigné).

# URL de base de l'API backend. Format : https://<host>/api
# Sans valeur fonctionnelle, le login e-mail échoue (« Pas de connexion… »).
API_BASE_URL=https://<host>/api

# Flavor/environnement de l'app. Valeurs : prod | staging | dev (défaut CI : prod).
CERTIGO_ENV=prod

# Assume un build e-mail/mot de passe UNIQUEMENT (social Entra désactivé) sans
# échec au démarrage en prod. Laisser vide/false pour exiger une config Entra
# complète en prod (voir docs/CONFIG_AUTH.md, AppEnv.validate).
ENTRA_OPTIONAL=

# ─────────────────────────────────────────────────────────────────────────────
# Entra External ID (Microsoft CIAM) — dart-define values for Flutter
# ─────────────────────────────────────────────────────────────────────────────
# These values are passed to Flutter as --dart-define at build time.
# They configure the MSAL/AppAuth flow used in lib/src/app_env.dart.
# The build is safe to run with empty values; the app simply won't enable
# the Entra sign-in flow (entraConfigured == false) until all are filled.
#
# How to obtain each value:
#   Azure Portal → External Identities → your CIAM tenant → App registrations
#   → <your App Registration> → Overview
# ─────────────────────────────────────────────────────────────────────────────

# App Registration client ID (the "Application (client) ID" GUID shown on the
# App Registration Overview blade).
# Replace with: Azure Portal → External ID tenant → App registrations → <app> → Overview
ENTRA_CLIENT_ID=<your-entra-app-registration-client-id>

# CIAM authority URL used by the APP. Format: https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0
# Certigo: https://certigoapp.ciamlogin.com/af721be8-5901-422a-b299-b9c57847b968/v2.0
# Use the tenant-NAME host for the app: it is the only return domain registered in
# the Sign in with Apple Services ID, and Apple rejects the tenant-GUID host. Tokens
# still carry the GUID-form issuer of the discovery document (measured 2026-10-04,
# docs/RELEASE_MOBILE.md section 2.3). The backend keeps the GUID form.
ENTRA_AUTHORITY=https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0

# Custom URI scheme registered as a redirect URI in the App Registration.
# Must match: App Registration → Authentication → Mobile and desktop applications
# Default for Certigo is certigo://auth/ — the TRAILING SLASH is required: the iOS
# AppAuth SDK validates the redirect URL against Azure/CIAM and, without the final
# slash, the social-login callback is not recognized on iOS (login hangs). Register
# this exact value (certigo://auth/) in the App Registration. The native scheme
# stays "certigo"; only change this if you registered a different URI.
ENTRA_REDIRECT_URI=certigo://auth/

# OAuth2 scope for the backend API. Format: api://<backend-app-client-id>/user_impersonation
# Replace <backend-app-client-id> with the App Registration client ID of the *backend* API
# (Azure Portal → External ID tenant → App registrations → <backend-api-app> → Overview)
ENTRA_API_SCOPE=api://<backend-app-client-id>/user_impersonation

# Domain hints for social identity providers. They send CIAM straight to the
# chosen provider, skipping the CIAM picker. Values measured on 2026-09-27 with
# prompt=login in a cookie-less browser (the app's defaults, see AppEnv):
#   apple    -> appleid.apple.com (Microsoft's documented value). Never use
#               apple.com: it leads to idmsac.apple.com (AppleConnect, Apple's
#               internal employee sign-in).
#   google   -> documented value; no acceleration measured (CIAM picker shown).
#   live.com -> login.live.com, the "Microsoft account" OIDC provider
#               (personal accounts only).
ENTRA_DOMAIN_HINT_GOOGLE=google
ENTRA_DOMAIN_HINT_APPLE=apple
ENTRA_DOMAIN_HINT_MICROSOFT=live.com

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (via Entra External ID)
# GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET sont configurés côté Azure CIAM,
# pas directement dans Flutter — rien à ajouter ici côté mobile.
# ─────────────────────────────────────────────────────────────────────────────
