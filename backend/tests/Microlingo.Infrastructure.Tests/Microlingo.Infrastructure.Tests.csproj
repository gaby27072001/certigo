<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The Cosmos SDK flows in transitively via Microlingo.Infrastructure; opt
         out of its legacy Newtonsoft.Json probe to match the Infrastructure project. -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Microlingo.Infrastructure\Microlingo.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Microlingo.Application\Microlingo.Application.csproj" />
    <ProjectReference Include="..\..\src\Microlingo.Domain\Microlingo.Domain.csproj" />
  </ItemGroup>

</Project>
