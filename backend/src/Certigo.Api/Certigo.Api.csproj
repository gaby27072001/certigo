<Project Sdk="Azure.Functions.Sdk/1.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <!-- Cosmos SDK loads Newtonsoft.Json via reflection at runtime; the isolated worker
         build does not copy it without a direct reference, causing a FileNotFoundException. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Certigo.Application\Certigo.Application.csproj" />
    <ProjectReference Include="..\Certigo.Infrastructure\Certigo.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Certigo.Api.Tests" />
  </ItemGroup>
  <UsingTask TaskName="CertigoBuildIdentityTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)..\..\BuildTasks\CertigoBuildIdentityTask.cs" />
    </Task>
  </UsingTask>
  <Target Name="GenerateCertigoBuildIdentity"
          BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="InitializeSourceControlInformation">
    <CertigoBuildIdentityTask SourceRevisionId="$(SourceRevisionId)"
                             BuildTimeUtc="$(CertigoBuildTimeUtc)"
                             ContinuousIntegrationBuild="$(ContinuousIntegrationBuild)"
                             GitHubActions="$(GITHUB_ACTIONS)"
                             GitHubWorkflow="$(GITHUB_WORKFLOW)"
                             GitHubEventName="$(GITHUB_EVENT_NAME)"
                             GitHubRef="$(GITHUB_REF)"
                             GitHubSha="$(GITHUB_SHA)">
      <Output TaskParameter="CommitSha" PropertyName="_CertigoCommitSha" />
      <Output TaskParameter="ValidatedBuildTimeUtc" PropertyName="_CertigoBuildTimeUtc" />
    </CertigoBuildIdentityTask>
    <ItemGroup>
      <AssemblyMetadata Include="Certigo.CommitSha" Value="$(_CertigoCommitSha)" />
      <AssemblyMetadata Include="Certigo.BuildTimeUtc" Value="$(_CertigoBuildTimeUtc)" />
    </ItemGroup>
  </Target>
</Project>
