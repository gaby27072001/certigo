{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "COSMOS_ENDPOINT": "https://<account>.documents.azure.com:443/",
    "COSMOS_DATABASE": "certigo",
    "BLOB_ENDPOINT": "https://<account>.blob.core.windows.net/",
    "DEPLOYMENT_CONTAINER_NAME": "app-package",
    "HEALTH_PROBE_TIMEOUT_SECONDS": "5",
    "HEALTH_PLATFORM_CLIENT_ID": "",
    "KeyVault__Uri": "https://<vault>.vault.azure.net/",
    "KeyVault__HealthSecretName": "AUTH-JWT-SIGNING-KEY",
    "AUTH_JWT_PREVIOUS_SIGNING_KEY": "",
    "TUTOR_LLM_ENABLED": "true",
    "TUTOR_LLM_ENDPOINT": "https://certigo-openai.services.ai.azure.com/api/projects/certigo-dev/openai/v1/",
    "TUTOR_LLM_API_SURFACE": "v1",
    "TUTOR_LLM_DEPLOYMENT": "gpt-5.4-mini",
    "TUTOR_LLM_API_VERSION": "2024-10-21",
    "TUTOR_LLM_MAX_OUTPUT_TOKENS": "400",
    "TUTOR_LLM_API_KEY": "",
    "ENTRA_AUTHORITY": "https://<domain>.ciamlogin.com/<tenant-id>/v2.0",
    "ENTRA_AUDIENCE": "api://<client-id>",
    "ENTRA_REAUTH_AUDIENCE": "<mobile-client-id>",
    "ENTRA_GRAPH_TENANT_ID": "<external-tenant-id>",
    "ENTRA_GRAPH_CLIENT_ID": "<confidential-client-id>",
    "ENTRA_GRAPH_CLIENT_SECRET": "",
    "ENTRA_GRAPH_CLIENT_SECRET_SECRET_URI": "https://<vault>.vault.azure.net/secrets/<name>/<version>",
    "ACCOUNT_DELETION_ENABLED": "false",
    "PERSON_LINKED_IDENTITY_V1": "off",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "<connection-string>"
  }
}
