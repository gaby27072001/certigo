{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "COSMOS_ENDPOINT": "https://<account>.documents.azure.com:443/",
    "COSMOS_DATABASE": "certigo",
    "BLOB_ENDPOINT": "https://<account>.blob.core.windows.net/",
    "DEPLOYMENT_CONTAINER_NAME": "app-package",
    "CONTENT_BLOB_ENDPOINT": "https://<content-account>.blob.core.windows.net/",
    "CONTENT_STORAGE_CLIENT_ID": "",
    "CONTENT_DESCRIPTOR_CONTAINER": "content-release-descriptors",
    "CONTENT_PUBLIC_CONTAINER": "content-public-releases",
    "CONTENT_PRIVATE_CONTAINER": "content-private-releases",
    "_NOTE_CONTENT_REPOSITORY_MODE": "⛔ PIÈGE CONNU, constaté le 2026-09-11. Ce gabarit livre 'legacy' À DESSEIN et doit le rester : infra/tests/content-storage.test.mjs vérifie que ce fichier vaut 'legacy'. Or l'environnement de DEV tourne en 'versioned' (docs/runbooks/PARCOURS_DEV_TRAVERSABLE.md, section « Activer le pipeline de contenu versionné sur dev »). Copier ce fichier tel quel donne donc un backend local qui NE SERT PAS le catalogue de dev : symptôme déjà observé une fois = « backend vide ». Pour reproduire dev en local, passer CONTENT_REPOSITORY_MODE à 'versioned' dans VOTRE local.settings.json (jamais dans ce gabarit). Cette clé _NOTE_* est de la documentation : elle n'est lue par aucun code. Invalidé le jour où dev repasse en 'legacy' ou où le gabarit cesse d'être verrouillé sur 'legacy'.",
    "CONTENT_REPOSITORY_MODE": "legacy",
    "CONTENT_ADMIN_ROLE": "Content.Release.Admin",
    "CONTENT_ADMIN_ALLOW_DEV": "true",
    "CONTENT_ALLOW_MUTABLE_BLOBS": "false",
    "CONTENT_IMPORT_MAX_FILES": "10000",
    "CONTENT_IMPORT_MAX_FILE_BYTES": "2097152",
    "CONTENT_IMPORT_MAX_RELEASE_BYTES": "134217728",
    "CONTENT_IMPORT_MAX_COSMOS_ITEM_BYTES": "1900000",
    "HEALTH_PROBE_TIMEOUT_SECONDS": "5",
    "HEALTH_PLATFORM_CLIENT_ID": "",
    "KeyVault__Uri": "https://<vault>.vault.azure.net/",
    "KeyVault__HealthSecretName": "AUTH-JWT-SIGNING-KEY",
    "AUTH_JWT_PREVIOUS_SIGNING_KEY": "",
    "TUTOR_LLM_ENABLED": "true",
    "TUTOR_LLM_ENDPOINT": "https://certigo-openai.services.ai.azure.com/api/projects/certigo-dev/openai/v1/",
    "TUTOR_LLM_API_SURFACE": "v1",
    "TUTOR_LLM_DEPLOYMENT": "gpt-5.4-mini",
    "TUTOR_LLM_API_VERSION": "2024-10-21",
    "TUTOR_LLM_MAX_OUTPUT_TOKENS": "400",
    "TUTOR_LLM_API_KEY": "",
    "ENTRA_AUTHORITY": "https://<domain>.ciamlogin.com/<tenant-id>/v2.0",
    "ENTRA_AUDIENCE": "api://<client-id>",
    "ENTRA_REAUTH_AUDIENCE": "<mobile-client-id>",
    "ENTRA_GRAPH_TENANT_ID": "<external-tenant-id>",
    "ENTRA_GRAPH_CLIENT_ID": "<confidential-client-id>",
    "ENTRA_GRAPH_CLIENT_SECRET": "",
    "ENTRA_GRAPH_CLIENT_SECRET_SECRET_URI": "https://<vault>.vault.azure.net/secrets/<name>/<version>",
    "ACCOUNT_DELETION_ENABLED": "false",
    "PERSON_LINKED_IDENTITY_V1": "off",
    "ORGANIZATION_MEMBERSHIP_V1": "off",
    "ORGANIZATION_SHADOW_OBSERVATION_SCHEDULE": "0 */15 * * * *",
    "ENTERPRISE_LEARNING_METRICS_V1": "off",
    "ENTERPRISE_LEARNING_RECOVERY_SCHEDULE": "0 */15 * * * *",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "<connection-string>"
  }
}
