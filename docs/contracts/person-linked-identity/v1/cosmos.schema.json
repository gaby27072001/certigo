{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certigo.app/contracts/person-linked-identity/v1/cosmos.schema.json",
  "title": "Certigo Person and LinkedIdentity Cosmos documents",
  "version": "1.0.0",
  "x-certigo-reconciled-main": {
    "commit": "978c38e9b64d12144ccc4bbe02ff1fe37c5c0458",
    "mergedPullRequests": [
      289,
      296,
      297,
      301,
      302,
      303,
      308
    ],
    "productionIdentityRuntimeChanged": false
  },
  "x-certigo-cosmos": {
    "container": "users",
    "partitionKey": "/id",
    "topologyChangeRequired": false,
    "partitionKeyChangeRequired": false,
    "uniqueKeyPolicyRequired": false,
    "identityIdStrategy": "linked-identity::v1::<sha256(certigo-linked-identity:v1 NUL provider NUL tenant NUL subject NUL type)>",
    "intentIdStrategy": "identity-link-intent::v1::<sha256(personId and Idempotency-Key)>",
    "operationIdStrategy": "identity-link-operation::v1::<sha256(personId and Idempotency-Key)>",
    "currentIndexingPolicy": {
      "indexingMode": "consistent",
      "automatic": true,
      "includedPaths": [
        "/*"
      ],
      "excludedPaths": [
        "/\"_etag\"/?"
      ]
    },
    "requiredAccessPatterns": [
      {
        "name": "resolveIdentity",
        "kind": "pointRead",
        "key": "linkedIdentity.id"
      },
      {
        "name": "readPerson",
        "kind": "pointRead",
        "key": "person.id"
      },
      {
        "name": "readIntent",
        "kind": "pointRead",
        "key": "sha256(personId and Idempotency-Key)"
      },
      {
        "name": "readOperation",
        "kind": "pointRead",
        "key": "sha256(personId and Idempotency-Key)"
      },
      {
        "name": "listPersonIdentities",
        "kind": "crossPartitionQuery",
        "predicate": "documentType = 'linkedIdentity' AND personId = @personId",
        "compositeIndexRequired": false
      },
      {
        "name": "reconcileAccountDeletionIdentities",
        "kind": "crossPartitionQuery",
        "predicate": "documentType = 'linkedIdentity' AND personId = @personId",
        "compositeIndexRequired": false
      }
    ]
  },
  "x-certigo-migration": {
    "mode": "additive",
    "personIdSource": "legacy userId",
    "requiredEquality": "personId == profile.id == legacy userId",
    "rewritesOwnerDocuments": false,
    "partitionKeyChanges": false,
    "existingOwnerContainers": [
      "users",
      "progress",
      "attempts",
      "events",
      "economy",
      "friends",
      "leaderboard"
    ]
  },
  "x-certigo-integrations": {
    "accountDeletion": {
      "baselinePullRequest": 296,
      "baselineState": "merged",
      "stateContainer": "attempts",
      "statePartitionKey": "/userId",
      "statePartitionValue": "sha256(personId)",
      "linkModeRequiresMultiIdentitySnapshot": true
    },
    "activeTrack": {
      "baselinePullRequest": 297,
      "baselineState": "merged",
      "owner": "personId",
      "profileDocumentUnchanged": true
    },
    "onboardingCatalog": {
      "baselinePullRequest": 289,
      "baselineState": "merged",
      "owner": "personId",
      "catalogDocumentsUnchanged": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/person"
    },
    {
      "$ref": "#/$defs/localCredentialIdentityOverlay"
    },
    {
      "$ref": "#/$defs/linkedIdentity"
    },
    {
      "$ref": "#/$defs/identityLinkIntent"
    },
    {
      "$ref": "#/$defs/identityLinkOperation"
    }
  ],
  "$defs": {
    "localCredentialIdentityOverlay": {
      "title": "Identity overlay on an existing local credential document",
      "type": "object",
      "required": [
        "id",
        "type",
        "userId",
        "identitySubject"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^credential::"
        },
        "type": {
          "const": "credential"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "description": "Permanent personId and legacy userId."
        },
        "identitySubject": {
          "type": "string",
          "pattern": "^[0-9a-f]{32,}$",
          "description": "Random opaque value persisted once with optimistic concurrency."
        }
      },
      "additionalProperties": true
    },
    "person": {
      "title": "Person overlay on the existing user profile document",
      "type": "object",
      "required": [
        "id",
        "identityMetadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Permanent personId and legacy userId."
        },
        "identityMetadata": {
          "type": "object",
          "x-certigo-equality": "personId == legacyUserId == containing profile id",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "personId",
            "legacyUserId",
            "migrationState",
            "migratedAt"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "personId": {
              "type": "string",
              "minLength": 1
            },
            "legacyUserId": {
              "type": "string",
              "minLength": 1
            },
            "migrationState": {
              "type": "string",
              "enum": [
                "shadow",
                "resolved"
              ]
            },
            "anchorLinkedIdentityId": {
              "type": [
                "string",
                "null"
              ]
            },
            "migratedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "linkedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentType",
        "schemaVersion",
        "personId",
        "locator",
        "verification",
        "revocation",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^linked-identity::v1::[0-9a-f]{64}$"
        },
        "documentType": {
          "const": "linkedIdentity"
        },
        "schemaVersion": {
          "const": 1
        },
        "personId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/identityLocator"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "revocation": {
          "$ref": "#/$defs/revocation"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "_etag": {
          "type": "string"
        }
      }
    },
    "identityLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tenant",
        "subject",
        "type"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "certigo-local",
            "entra-external-id"
          ]
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 32,
          "description": "Opaque local subject or validated Entra oid."
        },
        "type": {
          "type": "string",
          "enum": [
            "localPassword",
            "entraExternalId"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "provider": {
              "const": "certigo-local"
            },
            "tenant": {
              "const": "certigo"
            },
            "subject": {
              "pattern": "^[0-9a-f]{32,}$"
            },
            "type": {
              "const": "localPassword"
            }
          }
        },
        {
          "properties": {
            "provider": {
              "const": "entra-external-id"
            },
            "tenant": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "subject": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "type": {
              "const": "entraExternalId"
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "verifiedAt",
        "authenticatedAt"
      ],
      "properties": {
        "state": {
          "const": "verified"
        },
        "method": {
          "type": "string",
          "enum": [
            "legacyCredentialBackfill",
            "localPasswordReauthentication",
            "oidcReauthentication"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "generation",
        "providerAction"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "pending",
            "revoked"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "providerAction": {
          "type": "string",
          "enum": [
            "notApplicable",
            "notRequested",
            "pending",
            "completed",
            "failed"
          ]
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "userUnlinked",
            "accountDeletion",
            "securityResponse"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identityLinkIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentType",
        "schemaVersion",
        "personId",
        "sourceLinkedIdentityId",
        "targetProvider",
        "targetTenant",
        "targetType",
        "nonceHash",
        "requestHash",
        "status",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^identity-link-intent::v1::[0-9a-f]{64}$"
        },
        "documentType": {
          "const": "identityLinkIntent"
        },
        "schemaVersion": {
          "const": 1
        },
        "personId": {
          "type": "string"
        },
        "sourceLinkedIdentityId": {
          "type": "string"
        },
        "targetProvider": {
          "type": "string",
          "enum": [
            "certigo-local",
            "entra-external-id"
          ]
        },
        "targetTenant": {
          "type": "string",
          "minLength": 1
        },
        "targetType": {
          "type": "string",
          "enum": [
            "localPassword",
            "entraExternalId"
          ]
        },
        "nonceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "consumed",
            "expired",
            "failed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "consumedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resultOperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "_etag": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "targetProvider": {
              "const": "certigo-local"
            },
            "targetTenant": {
              "const": "certigo"
            },
            "targetType": {
              "const": "localPassword"
            }
          }
        },
        {
          "properties": {
            "targetProvider": {
              "const": "entra-external-id"
            },
            "targetTenant": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "targetType": {
              "const": "entraExternalId"
            }
          }
        }
      ]
    },
    "identityLinkOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentType",
        "schemaVersion",
        "personId",
        "intentId",
        "idempotencyKeyHash",
        "requestHash",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^identity-link-operation::v1::[0-9a-f]{64}$"
        },
        "documentType": {
          "const": "identityLinkOperation"
        },
        "schemaVersion": {
          "const": 1
        },
        "personId": {
          "type": "string"
        },
        "intentId": {
          "type": "string"
        },
        "linkedIdentityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotencyKeyHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "failed"
          ]
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "_etag": {
          "type": "string"
        }
      }
    }
  }
}
