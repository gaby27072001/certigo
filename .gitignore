# ─────────────────────────────────────────────────────────────
# Certigo — monorepo .gitignore (Flutter • Dart • .NET • Azure)
# ─────────────────────────────────────────────────────────────

# --- General ---
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Secrets / local config (NEVER commit) ---
*.env
.env*
!*.env.example
local.settings.json
appsettings.Development.json
*.publishsettings
*.pfx
*.key

# ============================================================
# Flutter / Dart  (apps/mobile, packages/*)
# ============================================================
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
# Flutter apps and Dart packages commit their pubspec.lock for reproducible CI
# and release builds. Regenerate lockfiles only with the pinned Flutter toolchain.
**/doc/api/
coverage/
*.iml
.fvm/

# Generated code (freezed/json_serializable/riverpod) — regenerated by build_runner
*.g.dart
*.freezed.dart
*.config.dart
*.gr.dart

# iOS
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner.app.dSYM.zip
*.ipa

# Android
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/android/app/google-services.json
*.keystore
*.jks
*.apk
*.aab

# macOS / Windows / Linux desktop shells (if ever enabled)
**/macos/Pods/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ============================================================
# .NET  (backend/)
# ============================================================
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
project.lock.json
artifacts/
TestResults/
*.trx
*.coverage
*.nupkg

# Azure Functions
backend/**/bin
backend/**/obj
.azurefunctions/

# ============================================================
# Azure / IaC
# ============================================================
.azure/
*.azurePubxml

# ============================================================
# Node (tooling only — content validation, scripts)
# ============================================================
node_modules/
npm-debug.log*

# ============================================================
# Tooling output (generated, never committed)
# ============================================================
tools/seed_output/
tools/__pycache__/
__pycache__/
*.pyc
infra/ci-runner/image/evidence/
# Pages legales generees par tools/build_public_pages.mjs. La source est
# docs/legal/*.md ; committer le HTML genere le ferait diverger en silence.
_site/
