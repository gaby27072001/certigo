{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://microlingo.app/schema/lesson.schema.json",
  "title": "Microlingo Lesson",
  "description": "Content-as-code definition of a single lesson. Authored in YAML, validated against this schema in CI, then published to Cosmos (content container, partitioned by trackId).",
  "type": "object",
  "required": ["id", "trackId", "unitId", "domainId", "title", "estMinutes", "blocks"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable lesson id, e.g. az900-l-capex-opex."
    },
    "trackId": { "type": "string", "description": "Owning certification track, e.g. az-900." },
    "unitId": { "type": "string" },
    "domainId": { "type": "string", "description": "Exam domain this lesson maps to." },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "estMinutes": { "type": "integer", "minimum": 1, "maximum": 20 },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["type", "conceptId"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["hook", "concept", "example", "code", "check", "recap"]
        },
        "conceptId": {
          "type": "string",
          "description": "Atomic concept taught/verified — links content to Cortex mastery state."
        },
        "title": { "type": "string" },
        "body": { "type": "string", "description": "Markdown (concept/example/recap/hook)." },
        "code": { "type": "string" },
        "language": { "type": "string" },
        "check": { "$ref": "#/$defs/item" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "code" } } },
          "then": { "required": ["code"] }
        },
        {
          "if": { "properties": { "type": { "const": "check" } } },
          "then": { "required": ["check"] }
        }
      ]
    },
    "item": {
      "type": "object",
      "description": "A quiz item. The answer key (correct, explanation) is authored here but STRIPPED before the public payload is sent to clients — grading is server-side.",
      "required": ["id", "conceptId", "type", "stem", "options", "correct", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "conceptId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["mcq", "multi", "scenario", "cloze", "ordering", "matchPairs", "spotTheIssue", "applied"]
        },
        "stem": { "type": "string", "minLength": 5 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "correct": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Option ids that are correct (one for mcq, many for multi/ordering)."
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "description": "Why the answer is right/wrong — shown after grading. Never empty."
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "1 recall · 2 apply · 3 analyze."
        }
      }
    }
  }
}
