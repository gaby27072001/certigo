{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.certigo.invalid/track.schema.json",
  "title": "Certigo Track",
  "description": "A certification track: weighted exam domains and an ordered list of units. Domain weights MUST sum to 1.0 and drive the Readiness Score.",
  "type": "object",
  "required": ["id", "code", "title", "domains", "units"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "code": { "type": "string", "description": "Official exam code, e.g. AZ-900." },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "level": { "type": "string", "enum": ["fundamentals", "associate", "expert"] },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Exam weight (fraction). All domain weights sum to 1.0."
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domainId", "title", "lessons"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "domainId": { "type": "string" },
          "title": { "type": "string" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "description": "Lesson id (file in lessons/)." }
          }
        }
      }
    }
  }
}
