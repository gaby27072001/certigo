    "certigo.content.package-manifest/v1",
    "certigo.content.package-manifest/v2",
    "certigo.content.package-manifest/v3"
  ],
  "activeManifestHeaders": [
    "ETag",
    "Cache-Control",
    "X-Content-Release-Id",
    "X-Content-Manifest-Id"
  ],
  "publicFileHeaders": [
    "ETag",
    "Content-Length",
    "Content-Type",
    "Cache-Control",
    "Accept-Ranges",
    "X-Content-SHA256",
    "X-Content-Release-Id",
    "X-Content-Manifest-Id"
  ],
  "forbiddenPublicFields": [
    "answerKey",
