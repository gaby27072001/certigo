{
  "schema": "certigo.ci-impact/v1",
  "version": 1,
  "defaultGates": [
    "preflight"
  ],
  "gates": {
    "preflight": [
      "**"
    ],
    "workflow-yaml": [
      ".github/workflows/**",
      ".github/ci/**"
    ],
    "security-policy": [
      ".github/**",
      "SECURITY.md",
      "codemagic.yaml",
      "infra/**",
      "tools/project_state.py",
      "tools/tests/test_project_state.py"
    ],
    "project-state": [
      ".github/workflows/**",
      "codemagic.yaml",
      "README.md",
      "package.json",
      "content/**",
      "backend/src/Certigo.Domain/Content/ContentModels.cs",
      "backend/tests/**",
      "apps/mobile/test/**",
      "apps/mobile/integration_test/**",
      "packages/*/test/**",
      "docs/active-content-reference.json",
      "docs/ETAT_DU_PROJET.md",
      "docs/project-state-reference.json",
      "tools/project_state.py",
      "tools/tests/**"
    ],
    "bicep-compile": [
      "infra/**/*.bicep",
      "infra/**/*.bicepparam",
      "infra/**/bicepconfig.json"
    ],
    "backend": [
      "backend/**",
      ".github/workflows/ci-backend.yml"
    ],
    "mobile": [
      "apps/**",
      "packages/**",
      ".github/workflows/ci-mobile.yml"
    ],
    "cortex-parity": [
      "packages/cortex/**",
      "backend/src/Certigo.Domain/**",
      "backend/tests/Certigo.Domain.Tests/**",
      ".github/workflows/ci-cortex-parity.yml"
    ],
    "content": [
      "content/**",
      "tools/validate_content.mjs",
      ".github/workflows/ci-content.yml"
    ],
    "dependency-scan": [
      ".gitignore",
      "**/.gitignore",
      "**/*.csproj",
      "**/*.sln",
      "**/Directory.Build.props",
      "**/Directory.Build.targets",
      "**/Directory.Packages.props",
      "**/NuGet.Config",
      "**/NuGet.config",
      "**/nuget.config",
      "**/packages.lock.json",
      "**/pubspec.yaml",
      "**/pubspec_overrides.yaml",
      "**/pubspec.lock",
      "**/.npmrc",
      "**/package.json",
      "**/package-lock.json",
      "**/npm-shrinkwrap.json",
      "global.json",
      ".github/osv-scanner.toml",
      ".github/workflows/dependency-vuln-scan.yml",
      ".github/workflows/security-gate.yml",
      ".github/scripts/install-verified-flutter.sh",
      "tools/validate_nuget_locks.py",
      "tools/validate_dependency_locks.py",
      "tools/verify_pub_locks.py",
      "tools/tests/test_validate_nuget_locks.py",
      "tools/tests/test_validate_dependency_locks.py",
      "tools/tests/test_verify_pub_locks.py"
    ],
    "iac-security": [
      "infra/**",
      ".checkov.yaml",
      ".github/scripts/public-domain-contract.mjs",
      ".github/scripts/public-domain-contract.test.mjs",
      ".github/scripts/publish-verified-public-pages.test.mjs",
      ".github/scripts/write-secure-bicep-parameters.mjs",
      ".github/scripts/write-secure-bicep-parameters.test.mjs",
      ".github/workflows/cd-backend.yml",
      ".github/workflows/publish-verified-public-pages.yml",
      ".github/workflows/release-android.yml",
      ".github/workflows/release-ios.yml",
      ".github/workflows/ci-infra.yml",
      ".github/workflows/security-scan.yml",
      ".github/workflows/security-gate.yml",
      "codemagic.yaml",
      "tools/build_public_pages.mjs",
      "tools/tests/build_public_pages.test.mjs",
      "tools/generate_link_associations.py",
      "tools/tests/test_generate_link_associations.py",
      "tools/tests/public_pages_security.test.mjs"
    ],
    "codeql-csharp": [
      "backend/**"
    ],
    "codeql-javascript": [
      "tools/**/*.js",
      "tools/**/*.mjs",
      ".github/scripts/**/*.js",
      ".github/scripts/**/*.mjs",
      "package.json",
      "package-lock.json"
    ],
    "codeql-python": [
      "tools/**/*.py"
    ]
  },
  "sensitiveAssertions": [
    {
      "path": ".github/workflows/security-gate.yml",
      "gates": [
        "preflight",
        "workflow-yaml",
        "security-policy",
        "project-state",
        "dependency-scan",
        "iac-security"
      ]
    },
    {
      "path": ".github/ci/impact-matrix.json",
      "gates": [
        "preflight",
        "workflow-yaml",
        "security-policy"
      ]
    },
    {
      "path": ".github/scripts/validate-workflow-security.mjs",
      "gates": [
        "preflight",
        "security-policy",
        "codeql-javascript"
      ]
    },
    {
      "path": "tools/project_state.py",
      "gates": [
        "preflight",
        "security-policy",
        "project-state",
        "codeql-python"
      ]
    },
    {
      "path": "infra/modules/functionApp.bicep",
      "gates": [
        "preflight",
        "security-policy",
        "bicep-compile",
        "iac-security"
      ]
    },
    {
      "path": "infra/modules/bicepconfig.json",
      "gates": [
        "preflight",
        "security-policy",
        "bicep-compile",
        "iac-security"
      ]
    },
    {
      "path": "backend/src/Certigo.Domain/Scoring/QuizScorer.cs",
      "gates": [
        "preflight",
        "backend",
        "cortex-parity",
        "codeql-csharp"
      ]
    },
    {
      "path": "packages/cortex/lib/src/readiness.dart",
      "gates": [
        "preflight",
        "mobile",
        "cortex-parity"
      ]
    },
    {
      "path": "content/az-900/lessons/example.lesson.yaml",
      "gates": [
        "preflight",
        "project-state",
        "content"
      ]
    },
    {
      "path": "backend/Directory.Packages.props",
      "gates": [
        "preflight",
        "backend",
        "dependency-scan",
        "codeql-csharp"
      ]
    }
  ]
}
