<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 (API 31) and higher.
  Android 11 and lower read backup_rules.xml instead; keep both files identical
  in intent.

  Only the flutter_secure_storage 9.x files are excluded, from cloud backup AND
  from device-to-device transfer (a mode without rules is fully enabled): they
  hold the OIDC session (tokens), encrypted with keys that stay in this device's
  Android Keystore. Everything else keeps the default behaviour.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
