# Fastlane — pipeline beta iOS de Certigo (TestFlight).
# Authentification via clé API App Store Connect (.p8) → pas d'Apple ID ni de 2FA.
#
# Deux modes de signature, choisis par le workflow (variable IOS_MATCH_GIT_URL) :
#   - fastlane match (recommandé) : certs & profils chiffrés dans un repo git ;
#     le workflow appelle `prepare_signing` qui installe la signature avant `beta`.
#   - manuel (repli) : le workflow installe certificat + profil dans un keychain
#     avant d'appeler `beta`.
# Dans les deux cas, `beta` construit puis uploade l'IPA en signature manuelle,
# en utilisant le nom de profil fourni via IOS_PROVISIONING_PROFILE_NAME.
default_platform(:ios)

BUNDLE_ID = "law-certigo".freeze

# Clé API App Store Connect (lecture des secrets depuis l'environnement).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Installe la signature via fastlane match (lecture seule) dans un keychain CI"
  lane :prepare_signing do
    setup_ci
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: true,
      api_key: asc_api_key
    )
  end

  desc "Crée / renouvelle les certificats & profils dans le repo match (lecture-écriture)"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      api_key: asc_api_key
    )
  end

  desc "Build l'IPA signé (signature manuelle) puis l'upload sur TestFlight"
  lane :beta do
    profile = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    team_id = ENV.fetch("IOS_TEAM_ID")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "certigo.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => profile }
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=\"#{profile}\""
    )

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "../build/ios/ipa/certigo.ipa",
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: ENV["TF_EXTERNAL"] == "true",
      groups: (ENV["TF_EXTERNAL"] == "true" ? [ENV.fetch("TF_EXTERNAL_GROUP", "Beta")] : nil),
      changelog: ENV["TF_CHANGELOG"]
    )
  end
end
